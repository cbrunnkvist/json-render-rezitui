# Gitignore for pnpm monorepo

# Node.js
node_modules/
*.js.map
*.d.ts.map
.pnpm-store/

# Build artifacts
dist/
build/
.next/
.turbo/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS and Editor specific
.DS_Store
.env
.env*.local
.vscode/
.idea/
*.sublime-*
*.bak
*.swp

# pnpm-specific
pnpm-lock.yaml
!/pnpm-workspace.yaml

# Sisyphus
.sisyphus/

# Coverage
coverage/

# Test results
/.vitestcache/
/test-results/

# Development references (submodules)
# reference/ submodules are tracked via git submodule
